#!/bin/sh
# A stand-in for openconnect: with --version, says which; otherwise reads the
# cookie, "connects" (a sleeping process standing in for the tunnel) and returns, as
# --background does.
[ "$1" = --version ] && { echo "OpenConnect version v9.99-fake"; exit 0; }
echo "$*" >"$FAKE_OC/args"
IFS= read -r cookie
echo "$cookie" >"$FAKE_OC/cookie"
[ -n "${FAKE_OC_FAIL:-}" ] && { echo "Failed to connect: $FAKE_OC_FAIL" >&2; exit 1; }
for a; do case "$a" in --pid-file=*) pidfile="${a#--pid-file=}" ;; esac; done
# (Python, since a background job of sh can't catch SIGINT, as openconnect does.)
python3 -c 'import signal, sys, time; signal.signal(signal.SIGINT, lambda *a: sys.exit(0)); time.sleep(1000)' >/dev/null 2>&1 </dev/null &
echo $! >"$pidfile"
echo "Connected as 10.0.0.2 (fake)" >&2
