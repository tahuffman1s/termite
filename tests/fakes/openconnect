#!/bin/sh
# A stand-in for openconnect: with --version, says which, and which
# vpnc-script is its default; otherwise reads the cookie, "connects" (a
# sleeping process standing in for the tunnel), runs the --script it was
# given as vpnc-script would be run on connect when FAKE_OC_DNS names the
# DNS servers, and returns, as --background does.
[ "$1" = --version ] && {
  echo "OpenConnect version v9.99-fake"
  echo "Default vpnc-script (override with --script): $(dirname "$0")/vpnc-script"
  exit 0
}
echo "$*" >"$FAKE_OC/args"
IFS= read -r cookie
echo "$cookie" >"$FAKE_OC/cookie"
[ -n "${FAKE_OC_FAIL:-}" ] && { echo "Failed to connect: $FAKE_OC_FAIL" >&2; exit 1; }
script=
for a; do case "$a" in --pid-file=*) pidfile="${a#--pid-file=}" ;; --script=*) script="${a#--script=}" ;; esac; done
if [ -n "$script" ] && [ -n "${FAKE_OC_DNS:-}" ]; then
  reason=connect TUNDEV=tun9 INTERNAL_IP4_DNS="$FAKE_OC_DNS" INTERNAL_IP6_DNS= CISCO_DEF_DOMAIN=corp.example.com "$script" </dev/null
fi
# (Python, since a background job of sh can't catch SIGINT, as openconnect does.)
python3 -c 'import signal, sys, time; signal.signal(signal.SIGINT, lambda *a: sys.exit(0)); time.sleep(1000)' >/dev/null 2>&1 </dev/null &
echo $! >"$pidfile"
echo "Connected as 10.0.0.2 (fake)" >&2
