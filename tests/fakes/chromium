#!/usr/bin/env python3
"""A stand-in for Chromium: answers DevTools calls on fds 3/4 the way the
real one does, after "signing in" by fetching the --app URL (which sets the
token cookie, like the gateway's SSO page). FAKE_BROWSER=exit quits at once,
as a second Chromium on a profile in use does; FAKE_BROWSER=close closes
the window before signing in."""
import json, os, sys, urllib.request

mode = os.environ.get("FAKE_BROWSER", "")
args = sys.argv[1:]
with open(os.environ["FAKE_BROWSER_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
if mode == "exit" or "--remote-debugging-pipe" not in args:
    sys.exit(0)
url = next(a.split("=", 1)[1] for a in args if a.startswith("--app="))
cookies, calls, buf = [], 0, b""
while True:
    chunk = os.read(3, 65536)
    if not chunk:
        sys.exit(0)
    buf += chunk
    while b"\0" in buf:
        raw, buf = buf.split(b"\0", 1)
        msg = json.loads(raw)
        if msg["method"] == "Browser.close":
            os.write(4, json.dumps({"id": msg["id"], "result": {}}).encode() + b"\0")
            sys.exit(0)
        calls += 1
        if mode == "close" and calls > 1:
            sys.exit(0)
        if calls == 2:  # the user finishes signing in
            with urllib.request.urlopen(url) as r:
                for h in r.headers.get_all("Set-Cookie") or []:
                    name, _, rest = h.partition("=")
                    cookies.append({"name": name, "value": rest.split(";")[0]})
        os.write(4, json.dumps({"id": msg["id"], "result": {"cookies": cookies}}).encode() + b"\0")
