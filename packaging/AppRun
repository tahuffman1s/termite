#!/bin/sh
# Starts Termite from the AppImage: the bundled Python, GTK 4 and
# libadwaita, with the host's graphics, fonts and CA certificates.
HERE="$(dirname "$(readlink -f "$0")")"

# The variables this changes, kept for the programs Termite starts (the
# browser, nmcli, openconnect), which must not load the bundled libraries
# (termite.sso.host_env puts them back).
VARS="LD_LIBRARY_PATH PYTHONHOME PYTHONPATH PYTHONNOUSERSITE GI_TYPELIB_PATH GSETTINGS_SCHEMA_DIR GIO_MODULE_DIR GIO_EXTRA_MODULES XKB_CONFIG_ROOT GDK_PIXBUF_MODULE_FILE GTK_EXE_PREFIX GTK_DATA_PREFIX GTK_PATH XDG_DATA_DIRS SSL_CERT_FILE OPENSSL_MODULES OPENSSL_CONF GSK_RENDERER FONTCONFIG_FILE"
unset_vars=""
for v in $VARS; do
  if eval "[ \"\${$v+set}\" = set ]"; then
    eval "export TERMITE_HOST_$v=\"\$$v\""
  else
    unset_vars="$unset_vars $v"
  fi
done
export TERMITE_HOST_VARS="$VARS" TERMITE_HOST_UNSET="$unset_vars"

cache_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/termite-appimage-$(id -u)"
mkdir -p "$cache_dir" 2>/dev/null

# The common libraries in usr/lib/fallback, for the ones this system
# doesn't keep in the usual places (NixOS): links to them in a directory of
# this run's own, as the AppImage is mounted somewhere new each time.
for d in "$cache_dir"/lib-* "$cache_dir"/chromium-*; do
  [ -d "$d" ] && [ ! -d "$(cat "$d/.from" 2>/dev/null)" ] && rm -rf "$d"
done
fallback_dir="$cache_dir/lib-$$"
mkdir -p "$fallback_dir" && printf '%s' "$HERE" >"$fallback_dir/.from"
for f in "$HERE"/usr/lib/fallback/*; do
  n="${f##*/}"
  for d in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib64 /lib64 /usr/lib /lib; do
    [ -e "$d/$n" ] && continue 2
  done
  ln -sf "$f" "$fallback_dir/$n"
done
own_fontconfig=0
[ -e "$fallback_dir/libfontconfig.so.1" ] && own_fontconfig=1

# The same for the bundled Chromium, whose libraries are its own business:
# a directory of links to the bundled ones the system doesn't have, which
# Termite puts on its LD_LIBRARY_PATH alone (termite.sso.browser_env).
chromium_dir="$cache_dir/chromium-$$"
mkdir -p "$chromium_dir" && printf '%s' "$HERE" >"$chromium_dir/.from"
for f in "$HERE"/usr/lib/chromium-deps/*.so*; do
  n="${f##*/}"
  for d in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib64 /lib64 /usr/lib /lib; do
    [ -e "$d/$n" ] && continue 2
  done
  ln -sf "$f" "$chromium_dir/$n"
done
[ -e "$chromium_dir/libnss3.so" ] && ln -sfn "$HERE/usr/lib/chromium-deps/nss" "$chromium_dir/nss"
export TERMITE_CHROMIUM="$HERE/usr/lib/chromium/chrome" TERMITE_CHROMIUM_LIBS="$chromium_dir"
# OpenConnect, for connecting without NetworkManager's plugin (termite.tunnel).
export TERMITE_OPENCONNECT_DIR="$HERE/usr/lib/openconnect"

export LD_LIBRARY_PATH="$HERE/usr/lib:$fallback_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONHOME="$HERE/usr"
unset PYTHONPATH
export PYTHONNOUSERSITE=1
export GI_TYPELIB_PATH="$HERE/usr/lib/girepository-1.0"
export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas"
# Only the bundled GIO and GTK modules (dconf, for the desktop's settings):
# the host's are built against its own, newer, GLib and GTK.
export GIO_MODULE_DIR="$HERE/usr/lib/gio/modules"
unset GIO_EXTRA_MODULES
export GTK_EXE_PREFIX="$HERE/usr"
export GTK_DATA_PREFIX="$HERE/usr"
unset GTK_PATH
# The host's icon themes first, the bundled Adwaita as the fallback.
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:$HERE/usr/share"
# Software rendering: a form like this doesn't need the GPU, and it keeps
# the host's GL drivers (and the libraries they need) out of the process.
export GSK_RENDERER="${GSK_RENDERER:-cairo}"

# Fonts: the system's fontconfig setup, or the usual font directories when
# there is none, or it is meant for the system's own (newer) fontconfig
# while the bundled one runs (NixOS).
if [ -z "${FONTCONFIG_FILE:-}" ] && { [ ! -e /etc/fonts/fonts.conf ] || [ "$own_fontconfig" = 1 ]; }; then
  export FONTCONFIG_FILE="$HERE/etc/fonts/fonts.conf"
fi

# Keyboard layouts, which GTK needs on Wayland; bundled for systems that
# keep them elsewhere (NixOS).
[ -d /usr/share/X11/xkb ] || export XKB_CONFIG_ROOT="$HERE/usr/share/X11/xkb"

# The bundled OpenSSL's modules, not the system's (or none), and no
# configuration of the system's, which is for its own OpenSSL.
export OPENSSL_MODULES="$HERE/usr/lib/ossl-modules" OPENSSL_CONF=/dev/null

# The bundled OpenSSL looks for CA certificates where Debian keeps them; use
# the host's bundle, wherever its distribution keeps it.
if [ -z "${SSL_CERT_FILE:-}" ]; then
  for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
    /etc/ssl/ca-bundle.pem /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/cert.pem; do
    if [ -r "$f" ]; then
      export SSL_CERT_FILE="$f"
      break
    fi
  done
fi

# Image loaders (SVG icons): the cache holds absolute paths, so it is made
# for wherever the AppImage is mounted this time.
export GDK_PIXBUF_MODULE_FILE="$cache_dir/loaders.cache"
"$HERE/usr/bin/gdk-pixbuf-query-loaders" "$HERE"/usr/lib/gdk-pixbuf-2.0/loaders/*.so >"$GDK_PIXBUF_MODULE_FILE.$$" 2>/dev/null &&
  mv -f "$GDK_PIXBUF_MODULE_FILE.$$" "$GDK_PIXBUF_MODULE_FILE"

# A script, not -m: that would put the current directory on sys.path.
exec "$HERE/usr/bin/python3" -s "$HERE/usr/bin/termite" "$@"
